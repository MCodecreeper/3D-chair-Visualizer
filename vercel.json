{
    "routes": [
      {
        "src": "/texture/textures/(.*)",
        "dest": "/texture/textures/$1",
        "headers": {
          "cache-control": "public, max-age=31536000, immutable"
        }
      },
      {
        "src": "/(.*)",
        "dest": "/index.html"
      }
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "builds": [
      {
        "src": "package.json",
        "use": "@vercel/next"
      }
    ],
    "outputDirectory": ".next"
  }